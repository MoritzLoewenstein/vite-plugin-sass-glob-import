{
	"name": "@moritzloewenstein/vite-plugin-sass-glob-import",
	"type": "module",
	"version": "8.0.0",
	"description": "Use glob syntax for imports in your main Sass or SCSS file.",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"biome:check": "biome check .",
		"biome:write": "biome check . --write",
		"biome:ci": "biome ci"
	},
	"author": {
		"name": "Malven Co.",
		"email": "chris@malven.co",
		"url": "https://malven.co"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"sass"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MoritzLoewenstein/vite-plugin-sass-glob-import.git"
	},
	"license": "MIT",
	"dependencies": {
		"ansi-colors": "^4.1.3",
		"glob": "^13.0.6",
		"minimatch": "^10.2.6"
	},
	"peerDependencies": {
		"vite": "^8.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "^22.20.5",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"volta": {
		"node": "22.20.0"
	}
}
